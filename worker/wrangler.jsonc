{
  // One codebase, two Workers sharing one D1 database. Resource names all start with "redbird-".
  "name": "redbird-public",
  "main": "src/public.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "redbird-trails", "database_id": "bd3d16ad-1545-466c-853f-a1ade401eed2", "migrations_dir": "migrations" }
  ],
  "env": {
    "public": {
      "name": "redbird-public",
      "main": "src/public.js",
      "workers_dev": true,
      "d1_databases": [
        { "binding": "DB", "database_name": "redbird-trails", "database_id": "bd3d16ad-1545-466c-853f-a1ade401eed2", "migrations_dir": "migrations" }
      ]
    },
    "admin": {
      "name": "redbird-admin",
      "main": "src/admin.js",
      "workers_dev": true,
      "assets": { "directory": "./admin-ui/dist", "binding": "ASSETS", "run_worker_first": true },
      "d1_databases": [
        { "binding": "DB", "database_name": "redbird-trails", "database_id": "bd3d16ad-1545-466c-853f-a1ade401eed2", "migrations_dir": "migrations" }
      ],
      "vars": {
        "ACCESS_TEAM": "darl.cloudflareaccess.com",
        // ADMIN_EMAILS (comma-separated) is a Worker secret, never committed: wrangler secret put ADMIN_EMAILS --env admin
        "ACCESS_AUD": "1812af903186dac10ce51edd755b44e570f5203b80785095a616363a3a3d7ec0"
      }
    }
  }
}
