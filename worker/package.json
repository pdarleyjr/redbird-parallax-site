    "deploy:admin": "node scripts/build-ui.mjs && wrangler deploy --env admin"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
