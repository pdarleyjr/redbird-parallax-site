{
  "name": "redbird-trails-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "test": "vitest run",
    "dev:public": "wrangler dev --env public",
    "dev:admin": "node scripts/build-ui.mjs && wrangler dev --env admin",
